{
  "AlarmName": "northstar-churn-rollback-canary-latency",
  "AlarmDescription": "Roll back the canary when its p95 ModelLatency exceeds 200 ms (200000 microseconds) for 3 consecutive 1-minute periods. Action: bash deployment/configs/rollback-action.sh",
  "Namespace": "AWS/SageMaker",
  "MetricName": "ModelLatency",
  "Dimensions": [
    {"Name": "EndpointName", "Value": "northstar-churn-prod"},
    {"Name": "VariantName", "Value": "canary"}
  ],
  "ExtendedStatistic": "p95",
  "Period": 60,
  "EvaluationPeriods": 3,
  "DatapointsToAlarm": 3,
  "Threshold": 200000,
  "ComparisonOperator": "GreaterThanThreshold",
  "TreatMissingData": "notBreaching",
  "Unit": "Microseconds"
}
